{
  "opencollection": "1.0.0",
  "info": {
    "name": "Credentially Public Compliance-packages References API",
    "version": "2.0.0"
  },
  "items": [
    {
      "info": {
        "name": "References",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Profile References",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.credentially.io/gateway/api/profile/:profileId/references",
            "headers": [
              {
                "name": "X-API-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "profileId",
                "value": "profile-123",
                "type": "path",
                "description": "Credentially profile ID."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns reference titles, employment dates, durations, and status for the requested profile.\n\n**Rate Limit:** `profile-references` (100 req / 1s)"
        }
      ]
    }
  ],
  "bundled": true
}