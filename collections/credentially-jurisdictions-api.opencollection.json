{
  "opencollection": "1.0.0",
  "info": {
    "name": "Credentially Public Compliance-packages Jurisdictions API",
    "version": "2.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Jurisdictions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get a jurisdiction by public id",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.credentially.io/gateway/api/jurisdictions/:id",
            "headers": [
              {
                "name": "X-API-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "\n\n**Rate Limit:** `get-jurisdiction` (100 req / 1s)"
        },
        {
          "info": {
            "name": "List jurisdictions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.credentially.io/gateway/api/jurisdictions",
            "headers": [
              {
                "name": "X-API-Version",
                "value": ""
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "\n\n**Rate Limit:** `list-jurisdictions` (100 req / 1s)"
        }
      ]
    }
  ],
  "bundled": true
}