{
  "opencollection": "1.0.0",
  "info": {
    "name": "Credentially Public Compliance-packages API",
    "version": "2.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Compliance-packages",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get all profile's compliance packages",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.credentially.io/gateway/api/compliance-packages/:profileId",
            "headers": [
              {
                "name": "X-API-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "profileId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Fetches a list of all compliance requirements for all assigned packages for the profile.\n\n**Rate Limit:** `profile-compliance-packages` (25 req / 1s)"
        },
        {
          "info": {
            "name": "Assign compliance packages to profile",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.credentially.io/gateway/api/compliance-packages/:profileId",
            "headers": [
              {
                "name": "X-API-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "profileId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Assign compliance packages (list of their ids) to profile.\n\n**Rate Limit:** `profile-compliance-packages` (25 req / 1s)"
        },
        {
          "info": {
            "name": "Get all organisation's compliance packages",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.credentially.io/gateway/api/compliance-packages",
            "headers": [
              {
                "name": "X-API-Version",
                "value": ""
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Fetches a list of all organisation's compliance packages.\n\n**Rate Limit:** `organisation-compliance-packages` (25 req / 1s)"
        }
      ]
    }
  ],
  "bundled": true
}