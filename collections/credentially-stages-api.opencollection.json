{
  "opencollection": "1.0.0",
  "info": {
    "name": "Credentially Public Compliance-packages Stages API",
    "version": "2.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Stages",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Update a stage's mutable fields (rename / recolour / enable-disable)",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://app.credentially.io/gateway/api/stages/:publicId",
            "headers": [
              {
                "name": "X-API-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "publicId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "\n\n**Rate Limit:** `update-stage` (25 req / 1s)"
        },
        {
          "info": {
            "name": "Reorder all stages",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://app.credentially.io/gateway/api/stages/order",
            "headers": [
              {
                "name": "X-API-Version",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Total reorder — the full left-to-right list of every stage public id in the org.\n\n**Rate Limit:** `reorder-stages` (25 req / 1s)"
        },
        {
          "info": {
            "name": "List stages (ordered, with cap meta)",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.credentially.io/gateway/api/stages",
            "headers": [
              {
                "name": "X-API-Version",
                "value": ""
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "\n\n**Rate Limit:** `list-stages` (100 req / 1s)"
        }
      ]
    }
  ],
  "bundled": true
}