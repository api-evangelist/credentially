{
  "opencollection": "1.0.0",
  "info": {
    "name": "Credentially Public Compliance-packages Dictionary API",
    "version": "2.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Dictionary",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Dictionary Values",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.credentially.io/gateway/api/dictionary/:dictionaryId",
            "headers": [
              {
                "name": "X-API-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "dictionaryId",
                "value": "",
                "type": "path"
              },
              {
                "name": "parentValue",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns the allowed values for a dictionary-type custom profile field. Use the dictionaryId from the jsonSchema returned by GET /api/profile/metadata.\n\n**Rate Limit:** `dictionary-lookup` (100 req / 1s)"
        }
      ]
    }
  ],
  "bundled": true
}