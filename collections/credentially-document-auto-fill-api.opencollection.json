{
  "opencollection": "1.0.0",
  "info": {
    "name": "Credentially Public Compliance-packages Document Auto-fill API",
    "version": "2.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Document Auto-fill",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Process and auto-fill fields from a new document",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.credentially.io/gateway/api/documents/auto-fill/process",
            "headers": [
              {
                "name": "X-API-Version",
                "value": ""
              }
            ],
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "request",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "file",
                  "type": "text",
                  "value": ""
                }
              ]
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Processes a newly uploaded file and returns extracted fields, validation outcome, and OCR metadata.\n\n**Rate Limit:** `shared-intensive-write-limit` (25 req / 1s)"
        },
        {
          "info": {
            "name": "Auto-fill fields from an existing document",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.credentially.io/gateway/api/documents/auto-fill/existing",
            "headers": [
              {
                "name": "X-API-Version",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Extracts structured field values from an existing stored document using your target schema.\n\n**Rate Limit:** `shared-intensive-write-limit` (25 req / 1s)"
        }
      ]
    }
  ],
  "bundled": true
}