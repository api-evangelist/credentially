{
  "opencollection": "1.0.0",
  "info": {
    "name": "Credentially Public Compliance-packages Subscriptions API",
    "version": "2.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Subscriptions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get all webhook subscriptions for this org",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.credentially.io/gateway/subscriptions",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get all webhook subscriptions for this org"
        },
        {
          "info": {
            "name": "Create a new webhook subscription",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.credentially.io/gateway/subscriptions",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Create a new webhook subscription"
        },
        {
          "info": {
            "name": "Delete a webhook subscription",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://app.credentially.io/gateway/subscriptions/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Delete a webhook subscription"
        }
      ]
    }
  ],
  "bundled": true
}