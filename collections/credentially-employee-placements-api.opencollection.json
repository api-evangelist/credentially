{
  "opencollection": "1.0.0",
  "info": {
    "name": "Credentially Public Compliance-packages Employee Placements API",
    "version": "2.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Employee Placements",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all placement notes for an employee",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.credentially.io/gateway/api/employees/:employeePublicId/placements/notes",
            "headers": [
              {
                "name": "X-API-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "employeePublicId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "\n\n**Rate Limit:** `list-employee-placement-notes` (100 req / 1s)"
        },
        {
          "info": {
            "name": "List PENDING and ACTIVE placements for an employee",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.credentially.io/gateway/api/employees/:employeePublicId/placements",
            "headers": [
              {
                "name": "X-API-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "employeePublicId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "All in-flight placements (PENDING or ACTIVE) for the employee. COMPLETED and CANCELLED are excluded.\n\n**Rate Limit:** `list-employee-placements` (100 req / 1s)"
        }
      ]
    }
  ],
  "bundled": true
}