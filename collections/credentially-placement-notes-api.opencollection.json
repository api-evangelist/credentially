{
  "opencollection": "1.0.0",
  "info": {
    "name": "Credentially Public Compliance-packages Placement Notes API",
    "version": "2.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Placement Notes",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List notes for a placement",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.credentially.io/gateway/api/placements/:placementId/notes",
            "headers": [
              {
                "name": "X-API-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "placementId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "\n\n**Rate Limit:** `list-placement-notes` (100 req / 1s)"
        },
        {
          "info": {
            "name": "Add a note to a placement",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.credentially.io/gateway/api/placements/:placementId/notes",
            "headers": [
              {
                "name": "X-API-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "placementId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "\n\n**Rate Limit:** `list-placement-notes` (100 req / 1s)"
        },
        {
          "info": {
            "name": "Delete a placement note",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://app.credentially.io/gateway/api/placements/:placementId/notes/:noteId",
            "headers": [
              {
                "name": "X-API-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "placementId",
                "value": "",
                "type": "path"
              },
              {
                "name": "noteId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "\n\n**Rate Limit:** `delete-placement-note` (25 req / 1s)"
        }
      ]
    }
  ],
  "bundled": true
}