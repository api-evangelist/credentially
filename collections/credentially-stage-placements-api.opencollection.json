{
  "opencollection": "1.0.0",
  "info": {
    "name": "Credentially Public Compliance-packages Stage Placements API",
    "version": "2.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Stage Placements",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Bulk-add placements to this stage",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.credentially.io/gateway/api/stages/:stagePublicId/placements/bulk",
            "headers": [
              {
                "name": "X-API-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "stagePublicId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Per-row execution — one failure doesn't poison the batch. Returns moved + skipped breakdown. Capped at 200 ids.\n\n**Rate Limit:** `bulk-add-stage-placements` (25 req / 1s)"
        },
        {
          "info": {
            "name": "List placements assigned to this stage (paginated, filterable)",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.credentially.io/gateway/api/stages/:stagePublicId/placements",
            "headers": [
              {
                "name": "X-API-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "stagePublicId",
                "value": "",
                "type": "path"
              },
              {
                "name": "locationPublicIds",
                "value": "",
                "type": "query",
                "description": "Filter by location public ids (plural, max 50)"
              },
              {
                "name": "jurisdictionPublicIds",
                "value": "",
                "type": "query",
                "description": "Filter by jurisdiction public ids (plural, max 50)"
              },
              {
                "name": "rolePublicIds",
                "value": "",
                "type": "query",
                "description": "Filter by role public ids (plural, max 50)"
              },
              {
                "name": "complianceStatus",
                "value": "",
                "type": "query",
                "description": "Filter by compliance status"
              },
              {
                "name": "startDateFrom",
                "value": "",
                "type": "query",
                "description": "Absolute start date floor (inclusive). Mutually exclusive with startsWithinDays."
              },
              {
                "name": "startDateTo",
                "value": "",
                "type": "query",
                "description": "Absolute start date ceiling (inclusive). Mutually exclusive with startsWithinDays."
              },
              {
                "name": "startsWithinDays",
                "value": "",
                "type": "query",
                "description": "Relative start window — N days from today (inclusive). Mutually exclusive with startDateFrom/To."
              },
              {
                "name": "page",
                "value": "",
                "type": "query"
              },
              {
                "name": "size",
                "value": "",
                "type": "query"
              },
              {
                "name": "sort",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Board-column read with the unified filter chip set (no employee filters). Default sort is position ASC.\n\n**Rate Limit:** `list-stage-placements` (100 req / 1s)"
        }
      ]
    }
  ],
  "bundled": true
}